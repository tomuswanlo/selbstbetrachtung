# Diese Datei sperrt jeglichen Web-Zugriff auf den Ordner (enthält hochgeladene
# Belege zu Ausgaben). Kein Geheimnis, kann problemlos versioniert werden.
# Ausgeliefert wird ein Beleg ausschließlich über die authentifizierte
# Download-Aktion in buchhaltung-admin.php.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
