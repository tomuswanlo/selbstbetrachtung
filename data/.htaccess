# Diese Datei sperrt jeglichen Web-Zugriff auf den Ordner (enthält die
# SQLite-Datenbank mit Terminen/Klientendaten). Kein Geheimnis, kann
# problemlos versioniert werden.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
